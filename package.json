{
  "name": "temp-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:rules && npm run validate:reference && tsc -b && vite build",
    "extract:rulebook": "python3 scripts/extract_rulebook_reference.py",
    "audit:rulebook": "python3 scripts/build_rulebook_transplant_audit.py",
    "lint": "eslint .",
    "test": "vitest run",
    "test:golden": "vitest run src/rules/goldenMaster.test.ts src/mobileLayout.test.ts",
    "test:rc": "vitest run src/rules/releaseCandidate.test.ts",
    "validate:rules": "vitest run src/rules/validation.test.ts",
    "validate:reference": "vitest run src/rulebook/referenceRegistry.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
